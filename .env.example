# ─── FalkorDB ────────────────────────────────────────────────────────────────
# Local Docker (docker compose up -d falkordb) or FalkorDB Cloud.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=clause_ripple

# ─── Agent planner (LLM) ─────────────────────────────────────────────────────
# The LLM only chooses which graph tool to call next and writes explanations.
# Graph tools (FalkorDB) decide facts; deterministic rules decide compliance.
#
# Leave LLM_PROVIDER empty to run the clearly-labelled deterministic playbook
# planner (no LLM). Supported providers:
#   anthropic          -> ANTHROPIC_API_KEY, LLM_MODEL e.g. claude-sonnet-5-5
#   openai             -> OPENAI_API_KEY,    LLM_MODEL = any tool-calling chat model id
#   ollama             -> local, free.       LLM_MODEL e.g. llama3.2:3b (LLM_BASE_URL defaults to http://localhost:11434/v1)
#   openai_compatible  -> any OpenAI-compatible endpoint (Groq, Gemini, OpenRouter...)
#                         set LLM_BASE_URL + LLM_API_KEY + LLM_MODEL
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── API ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
# Demo mode = synthetic AtlasAI world + safe internal actions only.
# It never means fake graph data, fake APIs or fake tool calls.
DEMO_MODE=true
# Seed the baseline demo graph automatically when the API starts and the graph is empty.
AUTO_SEED=true

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
